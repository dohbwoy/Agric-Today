:root{--forest:#173d27;--green:#347b3d;--lime:#d5e75b;--cream:#f6f5ed;--ink:#1d2a20;--muted:#6d776d}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:"DM Sans",sans-serif}a{color:inherit;text-decoration:none}.site-header{height:86px;padding:0 7vw;display:flex;align-items:center;justify-content:space-between;background:#fbfbf6;border-bottom:1px solid #e5e8dd}.wordmark{display:flex;gap:10px;align-items:center;font-weight:800;letter-spacing:.08em;font-size:17px;line-height:1.05}.wordmark-light{font-weight:500}.wordmark small{display:block;font-size:8px;letter-spacing:.2em;color:#648064;margin-top:6px}.mark{width:37px;height:37px;border-radius:50%;display:grid;place-items:center;background:var(--forest);color:var(--lime);font-size:22px}nav{display:flex;align-items:center;gap:32px;font-size:13px;font-weight:600}nav a:not(.nav-cta){color:#4e5d50}.nav-cta{padding:13px 17px;border:1px solid #b9c6b7;border-radius:3px}.hero{min-height:570px;position:relative;display:flex;align-items:center;padding:80px 10vw;color:#fff;background:linear-gradient(90deg,rgba(11,42,23,.9),rgba(14,54,26,.64) 48%,rgba(13,42,23,.13)),url('/greenminds-brand.jpg') center 58%/cover no-repeat;overflow:hidden}.hero-content{position:relative;z-index:1;max-width:650px}.eyebrow{font-size:10px;letter-spacing:.22em;font-weight:700;color:var(--lime)}.hero h1{font-family:"Playfair Display",serif;font-size:clamp(62px,9vw,112px);letter-spacing:-.055em;line-height:.98;margin:24px 0 18px}.hero h1 span{color:var(--lime);font-style:italic}.hero-content p{font-size:18px;color:#e2e9df;margin-bottom:35px}.button{display:inline-flex;align-items:center;gap:30px;background:var(--lime);color:var(--forest);padding:16px 19px;font-size:12px;font-weight:700;border-radius:2px}.hero-note{position:absolute;right:7vw;bottom:38px;font-family:"Playfair Display",serif;font-style:italic;font-size:18px;line-height:1.5;color:#e3edda;text-align:right}.intro{padding:95px 