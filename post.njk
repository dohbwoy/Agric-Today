px 7vw;background-position:58% center}.hero-note{right:7vw;font-size:14px}.intro{padding:65px 8vw;grid-template-columns:1fr;gap:12px}.latest{padding:65px 6vw}.section-head{align-items:start;gap:18px;flex-direction:column}.article-grid{grid-template-columns:1fr 1fr}.article-image{height:190px}.newsletter{grid-template-columns:1fr;gap:15px;padding:55px 8vw}.newsletter .button{justify-self:start}.footer{grid-template-columns:1fr;gap:13px;padding:28px 7vw}.footer>a:nth-of-type(2){text-align:left}.footer small{grid-column:auto}}@media(max-width:520px){.article-grid{grid-template-columns:1fr}.article-image{height:230px}.hero h1{font-size:64px}.section-caption{line-height:1.6}.article-copy p{min-height:0}.wordmark{font-size:14px}.mark{width:33px;height:33px}}